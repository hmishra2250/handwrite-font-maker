# Handwrite Font Maker private alpha. Copy to .env.alpha and replace secrets.
# This profile is local-disk only: no DATABASE_URL, Supabase, or payment keys.
DEPLOYMENT_MODE=private_alpha
SITE_URL=http://localhost:3000

# Compose-internal API URL. Do not change for docker-compose.alpha.yml.
WORKER_API_BASE_URL=http://api:8000

# Generate a long random value, for example:
#   python3 - <<'PY'
#   import secrets; print(secrets.token_urlsafe(48))
#   PY
INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Compose container paths. scripts/alpha-dev.sh maps these to ./.alpha/* for host-local dev.
ALPHA_DATABASE_PATH=/data/alpha.sqlite3
LOCAL_OBJECT_ROOT=/data/objects
PROCESS_JOBS_INLINE=0
BILLING_ENABLED=0

# Alpha quotas. These are alpha abuse quotas, not paid credits; 300 uploads covers a 94-glyph guided build with source+mask uploads.
DAILY_UPLOAD_LIMIT=300
DAILY_UPLOAD_BYTES_LIMIT=524288000
DAILY_PREVIEW_LIMIT=200
DAILY_BUILD_LIMIT=10
ACTIVE_JOB_LIMIT=2
JOB_LEASE_SECONDS=60
JOB_TIMEOUT_SECONDS=1200
JOB_MAX_ATTEMPTS=3

# Optional local ONNX models mounted read-only from ./.models into /models.
# Deterministic default is 4g/2 CPUs. For BOTH concurrent ML families set 8g/4 CPUs;
# start with a 16GB host, then measure actual peak memory/latency.
ALPHA_API_MEMORY_LIMIT=4g
ALPHA_API_CPUS=2.0
# INSTALL_ML=false keeps images smaller. Set INSTALL_ML=true only after installing models locally.
INSTALL_ML=false
# HANDWRITE_EFFICIENTSAM_MODEL_DIR=/models/efficientsam
# HANDWRITE_MODEL_DIR=/models/slimsam
# HANDWRITE_SEGMENTATION_VARIANT=fp32
