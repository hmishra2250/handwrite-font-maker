# Copy to ignored .env.beta. Replace every placeholder before running preflight.
DEPLOYMENT_MODE=invite_beta
SITE_URL=https://fonts.example.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_PROJECT_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_KEY
SUPABASE_STORAGE_BUCKET=handwrite-font-jobs
DATABASE_URL=postgresql://REPLACE_WITH_DATABASE_CONNECTION
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WORKER_API_BASE_URL=http://api:8000
PROCESS_JOBS_INLINE=0
JOB_LEASE_SECONDS=60
JOB_TIMEOUT_SECONDS=600
JOB_MAX_ATTEMPTS=3
STORAGE_DELETE_GRACE_SECONDS=120
# Model files must be explicitly installed before mounting read-only.
INSTALL_ML=false
HANDWRITE_EFFICIENTSAM_MODEL_DIR=/models/efficientsam
HANDWRITE_MODEL_DIR=/models/slimsam
HANDWRITE_SEGMENTATION_VARIANT=fp32
# There is no paid checkout or project-credit ledger in this invite beta.
BILLING_ENABLED=false
# Per-account daily beta safety limits, not billing credits.
DAILY_UPLOAD_LIMIT=150
DAILY_UPLOAD_BYTES_LIMIT=209715200
DAILY_PREVIEW_LIMIT=120
DAILY_BUILD_LIMIT=5
ACTIVE_JOB_LIMIT=2
