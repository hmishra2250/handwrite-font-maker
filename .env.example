# Development only. Copy to a local ignored env file; never commit secrets.
# Python API (server.py reads process environment, not this file automatically):
DEPLOYMENT_MODE=local
HOST=127.0.0.1
PORT=8000
JOB_STORE_PATH=/tmp/handwrite-alpha-jobs.json
LOCAL_OBJECT_ROOT=/tmp/handwrite-alpha-objects
PROCESS_JOBS_INLINE=1

# Next.js: put WORKER_API_BASE_URL in web/.env.local for local font processing.
WORKER_API_BASE_URL=http://127.0.0.1:8000

# For invite beta use .env.beta.example + docs/DEPLOYMENT.md (not this local profile).
# Staging backend settings:
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=handwrite-font-jobs

# Optional local pretrained segmentation (install explicitly; never downloaded by requests).
# HANDWRITE_MODEL_DIR=/absolute/path/to/.models/slimsam
HANDWRITE_SEGMENTATION_VARIANT=fp32
# HANDWRITE_EFFICIENTSAM_MODEL_DIR=/absolute/path/to/.models/efficientsam

# Single-user local development only; authenticated projects use PostgreSQL.
PROJECT_STORE_PATH=/tmp/handwrite-projects.json
FEEDBACK_STORE_PATH=/tmp/handwrite-feedback.json
